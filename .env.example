# .env.example: Weave 环境变量模板
# 
# 用途：生产环境复制为 .env 并修改密钥后启动
# 注意：不要提交这个文件到 git！已加入 .gitignore
# 
# 必填变量（生产环境必须替换默认值）:
WEAVE_API_KEY=<替换为你的安全 token,建议随机生成>
DASHSCOPE_API_KEY=<DashScope API Key (阿里云 DashScope 控制台申请)>
DEEPSEEK_API_KEY=<DeepSeek API Key (DeepSeek OpenAPI 平台申请)>

# Redis 配置（使用内置 Redis 时不需要改）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Weave 服务配置
WEAVE_HOST=0.0.0.0
WEAVE_PORT=8000

# 向量/图库路径（Docker 容器内使用 /data/xxx；本地直接用当前目录）
VECTOR_DB_PATH=/data/vector_db
GRAPH_DB_PATH=/data/graph_db
RELATIONAL_DB_PATH=/data/weave.db

# 行为参数（按需调整）
CHUNK_SIZE=1500             # 文本切块大小 (字符数)
CHUNK_OVERLAP=200           # 重叠区大小
DB_CALL_TIMEOUT=30.0        # SQLite/Kuzu/LanceDB调用超时(秒)
DB_CALL_MAX_RETRIES=2       # 锁竞争类瞬时错误重试次数
QUEUE_POLL_TIMEOUT=5        # worker BRPOP阻塞超时(秒)
SESSION_MAX_ITEMS=50        # 会话记忆上限条数
SESSION_TTL_DAYS=7          # 会话记忆 TTL(天)

# LLM 模型名 (如需要切换模型可改这里)
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
