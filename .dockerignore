# ============================================
# Docker 构建上下文排除清单
# 目标：缩小上下文体积、避免把密钥/本地数据打进镜像
# ============================================

# 密钥：绝不进入镜像，运行时经 env_file / environment 注入
.env

# 本地数据目录：三库数据与前端页面，运行时通过卷挂载
data/

# 本地虚拟环境与 Python 缓存（镜像内会重新创建 .venv）
.venv/
venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.pytest_tmp/

# 测试、文档与 SDD 执行台账不参与运行时镜像
tests/
docs/
.superpowers/

# 版本控制元数据
.git/
